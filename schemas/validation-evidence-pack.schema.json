{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qualityci.local/schemas/validation-evidence-pack.schema.json",
  "title": "QualityCI Validation Evidence Pack 0.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "phase", "members"],
  "properties": {
    "contract_version": {"const": "qualityci-validation-evidence-pack-0.1"},
    "phase": {"enum": ["SOURCE", "RESOLVED"]},
    "members": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1024,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source_id", "source_path", "evidence_id", "format", "phase"],
        "properties": {
          "source_id": {"type": "string", "minLength": 1, "pattern": "\\S"},
          "source_path": {"type": "string", "minLength": 1, "pattern": "^(?![.]{1,2}$)(?![\\s\\S]*[/\\\\#])(?![\\s\\S]*[\\u0000-\\u001F])\\S(?:[\\s\\S]*\\S)?$"},
          "evidence_id": {"type": "string", "minLength": 1, "pattern": "\\S"},
          "format": {"const": "JSON"},
          "phase": {"enum": ["SOURCE", "RESOLVED"]}
        }
      }
    }
  }
}
