{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qualityci.local/schemas/replay-ledger.schema.json",
  "title": "QualityCI Replay Ledger Payload",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version", "replay_admission_hash", "assurance_state",
    "resolution_id", "artifact_set_hash", "controlled_reference_set_hash",
    "controlled_reference_source_set_hash", "source_validation_evidence_set_hash",
    "resolved_validation_evidence_set_hash", "validation_evidence_pair_hash",
    "approved_case_hash",
    "before_run", "after_case", "after_run", "baseline"
  ],
  "properties": {
    "contract_version": {"enum": ["qualityci-replay-ledger-0.2", "qualityci-replay-ledger-0.3", "qualityci-replay-ledger-0.4", "qualityci-replay-ledger-0.5"]},
    "replay_admission_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "assurance_state": {"const": "ATTESTED_REPLACEMENT"},
    "resolution_id": {"type": "string", "minLength": 1},
    "artifact_set_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "controlled_reference_set_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "controlled_reference_source_set_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "source_validation_evidence_set_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "resolved_validation_evidence_set_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "validation_evidence_pair_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "approved_case_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "approval_subject_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "approval_assertion_set_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "authorization_record_set_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "authorization_record_set_contract_version": {"const": "qualityci-authorization-record-set-0.2"},
    "authorization_authenticity_state": {"const": "PASS"},
    "authorization_authenticity_context_hash": {"type": "string", "minLength": 64, "maxLength": 64, "pattern": "^[0-9a-f]{64}$"},
    "authorization_authenticity_binding_hash": {"type": "string", "minLength": 64, "maxLength": 64, "pattern": "^[0-9a-f]{64}$"},
    "authorization_trust_snapshot_hash": {"type": "string", "minLength": 64, "maxLength": 64, "pattern": "^[0-9a-f]{64}$"},
    "authorization_trust_snapshot_contract_version": {"const": "qualityci-authorization-trust-snapshot-0.1"},
    "authorization_trust_policy_hash": {"type": "string", "minLength": 64, "maxLength": 64, "pattern": "^[0-9a-f]{64}$"},
    "authorization_trust_policy_version": {"const": "qualityci-authorization-trust-policy-0.1"},
    "replay_authorization_authenticity_binding_hash": {"type": "string", "minLength": 64, "maxLength": 64, "pattern": "^[0-9a-f]{64}$"},
    "execution_nonce": {"type": "string", "minLength": 1},
    "use_policy": {"const": "SINGLE_REPLAY"},
    "consumption_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "before_run": {"$ref": "#/$defs/runIdentity"},
    "before_case_source": {"$ref": "#/$defs/caseSourceIdentity"},
    "after_case": {"$ref": "#/$defs/caseIdentity"},
    "after_run": {"$ref": "#/$defs/runIdentity"},
    "after_case_source": {"$ref": "#/$defs/derivedCaseSourceIdentity"},
    "baseline": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["baseline_id", "baseline_hash"],
          "properties": {
            "baseline_id": {"type": "string", "pattern": "^[0-9a-f]{16}$"},
            "baseline_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
          }
        }
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {"contract_version": {"enum": ["qualityci-replay-ledger-0.3", "qualityci-replay-ledger-0.4", "qualityci-replay-ledger-0.5"]}},
        "required": ["contract_version"]
      },
      "then": {
        "required": [
          "approval_subject_hash", "approval_assertion_set_hash",
          "authorization_record_set_hash", "execution_nonce", "use_policy",
          "consumption_hash"
        ]
      },
      "else": {
        "not": {
          "anyOf": [
            {"required": ["approval_subject_hash"]},
            {"required": ["approval_assertion_set_hash"]},
            {"required": ["authorization_record_set_hash"]},
            {"required": ["execution_nonce"]},
            {"required": ["use_policy"]},
            {"required": ["consumption_hash"]}
          ]
        }
      }
    },
    {
      "if": {
        "properties": {"contract_version": {"enum": ["qualityci-replay-ledger-0.4", "qualityci-replay-ledger-0.5"]}},
        "required": ["contract_version"]
      },
      "then": {
        "required": [
          "authorization_record_set_contract_version",
          "authorization_authenticity_state",
          "authorization_authenticity_context_hash",
          "authorization_authenticity_binding_hash",
          "authorization_trust_snapshot_hash",
          "authorization_trust_snapshot_contract_version",
          "authorization_trust_policy_hash",
          "authorization_trust_policy_version",
          "replay_authorization_authenticity_binding_hash"
        ]
      },
      "else": {
        "not": {
          "anyOf": [
            {"required": ["authorization_record_set_contract_version"]},
            {"required": ["authorization_authenticity_state"]},
            {"required": ["authorization_authenticity_context_hash"]},
            {"required": ["authorization_authenticity_binding_hash"]},
            {"required": ["authorization_trust_snapshot_hash"]},
            {"required": ["authorization_trust_snapshot_contract_version"]},
            {"required": ["authorization_trust_policy_hash"]},
            {"required": ["authorization_trust_policy_version"]},
            {"required": ["replay_authorization_authenticity_binding_hash"]}
          ]
        }
      }
    },
    {
      "if": {
        "properties": {"contract_version": {"const": "qualityci-replay-ledger-0.5"}},
        "required": ["contract_version"]
      },
      "then": {
        "required": ["before_case_source", "after_case_source"]
      },
      "else": {
        "not": {
          "anyOf": [
            {"required": ["before_case_source"]},
            {"required": ["after_case_source"]}
          ]
        }
      }
    }
  ],
  "$defs": {
    "caseSourceIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "case_source_assurance_state",
        "case_source_pack_contract_version",
        "case_source_set_contract_version",
        "case_source_set_hash",
        "case_source_binding_hash",
        "case_source_lineage_contract_version",
        "case_source_lineage_hash"
      ],
      "properties": {
        "case_source_assurance_state": {
          "enum": [
            "BOUND_RAW_SOURCE_CASE",
            "SOURCE_ROOTED_DERIVATION"
          ]
        },
        "case_source_pack_contract_version": {
          "const": "qualityci-case-source-pack-0.1"
        },
        "case_source_set_contract_version": {
          "const": "qualityci-case-source-set-0.1"
        },
        "case_source_set_hash": {
          "type": "string",
          "minLength": 64,
          "maxLength": 64,
          "pattern": "^[0-9a-f]{64}$"
        },
        "case_source_binding_hash": {
          "type": "string",
          "minLength": 64,
          "maxLength": 64,
          "pattern": "^[0-9a-f]{64}$"
        },
        "case_source_lineage_contract_version": {
          "oneOf": [
            {"type": "null"},
            {"const": "qualityci-case-source-lineage-0.1"}
          ]
        },
        "case_source_lineage_hash": {
          "oneOf": [
            {"type": "null"},
            {
              "type": "string",
              "minLength": 64,
              "maxLength": 64,
              "pattern": "^[0-9a-f]{64}$"
            }
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "case_source_assurance_state": {
                "const": "BOUND_RAW_SOURCE_CASE"
              }
            },
            "required": ["case_source_assurance_state"]
          },
          "then": {
            "properties": {
              "case_source_lineage_contract_version": {"type": "null"},
              "case_source_lineage_hash": {"type": "null"}
            }
          },
          "else": {
            "properties": {
              "case_source_lineage_contract_version": {
                "const": "qualityci-case-source-lineage-0.1"
              },
              "case_source_lineage_hash": {
                "type": "string",
                "minLength": 64,
                "maxLength": 64,
                "pattern": "^[0-9a-f]{64}$"
              }
            }
          }
        }
      ]
    },
    "derivedCaseSourceIdentity": {
      "allOf": [
        {"$ref": "#/$defs/caseSourceIdentity"},
        {
          "type": "object",
          "properties": {
            "case_source_assurance_state": {
              "const": "SOURCE_ROOTED_DERIVATION"
            }
          }
        }
      ]
    },
    "caseIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["case_id", "case_hash"],
      "properties": {
        "case_id": {"type": "string", "minLength": 1},
        "case_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "runIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "run_id", "case_id", "case_hash", "status",
        "reference_assurance_state", "reference_set_hash",
        "reference_contract_version", "validation_assurance_state",
        "validation_evidence_set_hash", "validation_evidence_contract_version",
        "run_hash"
      ],
      "properties": {
        "run_id": {"type": "string", "pattern": "^[0-9a-f]{16}$"},
        "case_id": {"type": "string", "minLength": 1},
        "case_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "status": {"enum": ["PASS", "CONTRADICTED", "UNVERIFIABLE"]},
        "reference_assurance_state": {"const": "ATTESTED_REFERENCE_SET"},
        "reference_set_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "reference_contract_version": {"const": "qualityci-controlled-reference-0.1"},
        "validation_assurance_state": {"const": "ATTESTED_VALIDATION_SET"},
        "validation_evidence_set_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "validation_evidence_contract_version": {"const": "qualityci-validation-evidence-0.1"},
        "run_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    }
  }
}
