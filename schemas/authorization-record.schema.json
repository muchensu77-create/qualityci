{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qualityci.local/schemas/authorization-record.schema.json",
  "title": "QualityCI Authorization Record Declaration 0.1 / Signed Record 0.2",
  "type": "object",
  "additionalProperties": false,
  "x-runtimeCrossFieldChecks": [
    "effective_from<=expires_at",
    "0.2:effective_from<=issued_at<=expires_at",
    "canonical-json-bytes"
  ],
  "required": [
    "contract_version", "record_id", "approver_id_claim", "role_claim",
    "purpose_code", "scope_code", "effective_from", "expires_at"
  ],
  "properties": {
    "contract_version": {"enum": ["qualityci-authorization-record-0.1", "qualityci-authorization-record-0.2"]},
    "record_id": {"type": "string", "minLength": 1, "pattern": "^(?![\\s\\S]*[\\u0000-\\u001F])\\S(?:[\\s\\S]*\\S)?$"},
    "approver_id_claim": {"type": "string", "minLength": 1, "pattern": "^(?![\\s\\S]*[\\u0000-\\u001F])\\S(?:[\\s\\S]*\\S)?$"},
    "role_claim": {"enum": ["QUALITY_MANAGER", "PROCESS_OWNER"]},
    "purpose_code": {"const": "APPLY_APPROVED_RESOLUTION"},
    "scope_code": {"const": "EXACT_SUBJECT"},
    "effective_from": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?![\\s\\S]*[\\u0000-\\u001F])[0-9]{4}-[0-9]{2}-[0-9]{2}T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](?:\\.[0-9]+)?Z$"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?![\\s\\S]*[\\u0000-\\u001F])[0-9]{4}-[0-9]{2}-[0-9]{2}T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](?:\\.[0-9]+)?Z$"
    },
    "trust_domain": {"type": "string", "minLength": 1, "pattern": "^(?![\\s\\S]*[\\u0000-\\u001F])\\S(?:[\\s\\S]*\\S)?$"},
    "issuer_id": {"type": "string", "minLength": 1, "pattern": "^(?![\\s\\S]*[\\u0000-\\u001F])\\S(?:[\\s\\S]*\\S)?$"},
    "verification_key_id": {"type": "string", "minLength": 1, "pattern": "^(?![\\s\\S]*[\\u0000-\\u001F])\\S(?:[\\s\\S]*\\S)?$"},
    "issued_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?![\\s\\S]*[\\u0000-\\u001F])[0-9]{4}-[0-9]{2}-[0-9]{2}T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](?:\\.[0-9]+)?Z$"
    },
    "signature_algorithm": {"const": "ED25519"},
    "signature": {"type": "string", "minLength": 88, "maxLength": 88, "pattern": "^[A-Za-z0-9+/]{85}[AQgw]==$"}
  },
  "allOf": [
    {
      "if": {"properties": {"contract_version": {"const": "qualityci-authorization-record-0.1"}}},
      "then": {
        "not": {
          "anyOf": [
            {"required": ["trust_domain"]}, {"required": ["issuer_id"]},
            {"required": ["verification_key_id"]}, {"required": ["issued_at"]},
            {"required": ["signature_algorithm"]}, {"required": ["signature"]}
          ]
        }
      },
      "else": {
        "required": [
          "trust_domain", "issuer_id", "verification_key_id", "issued_at",
          "signature_algorithm", "signature"
        ]
      }
    }
  ]
}
