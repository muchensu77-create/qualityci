{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qualityci.local/schemas/revision-artifact-subject.schema.json",
  "title": "QualityCI Revision Artifact Approval Subject",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "replacement_set_id", "artifact_set_hash", "artifact_contract_version",
    "reference_contract_version", "controlled_reference_set_hash",
    "controlled_reference_source_set_hash",
    "case_schema_version", "parser_contract_version",
    "mapping_contract_version", "security_root_policy_version",
    "touched_document_artifacts"
  ],
  "properties": {
    "replacement_set_id": {"type": "string", "minLength": 1},
    "artifact_set_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "controlled_reference_set_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "controlled_reference_source_set_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "reference_contract_version": {"const": "qualityci-controlled-reference-0.1"},
    "artifact_contract_version": {"const": "qualityci-revision-artifact-0.3"},
    "case_schema_version": {"const": "qualityci-case-0.4"},
    "parser_contract_version": {"const": "qualityci-ingestion-policy-0.2"},
    "mapping_contract_version": {"const": "qualityci-explicit-mapping-0.5"},
    "security_root_policy_version": {"const": "qualityci-artifact-root-policy-0.1"},
    "touched_document_artifacts": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/artifactIndex"}
    }
  },
  "$defs": {
    "artifactIndex": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "document_id", "source_id", "source_path", "source_hash",
        "size_bytes", "declared_format", "detected_format", "supersedes"
      ],
      "properties": {
        "document_id": {"type": "string", "minLength": 1},
        "source_id": {"type": "string", "minLength": 1},
        "source_path": {"type": "string", "minLength": 1},
        "source_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "size_bytes": {"type": "integer", "minimum": 1},
        "declared_format": {"enum": ["CSV", "DOCX"]},
        "detected_format": {"enum": ["CSV", "DOCX"]},
        "supersedes": {
          "type": "object",
          "additionalProperties": false,
          "required": ["document_id", "revision", "source_hash"],
          "properties": {
            "document_id": {"type": "string", "minLength": 1},
            "revision": {"type": "string", "minLength": 1},
            "source_hash": {"type": "string", "minLength": 1}
          }
        }
      }
    }
  }
}
