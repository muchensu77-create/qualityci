{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qualityci.local/schemas/revision-artifact-manifest.schema.json",
  "title": "QualityCI Revision Artifact Pack",
  "type": "object",
  "additionalProperties": false,
  "required": ["manifest_version", "replacement_set_id", "case_schema_version", "parser_contract_version", "mapping_contract_version", "security_root_policy_version", "documents"],
  "properties": {
    "manifest_version": {"const": "qualityci-revision-artifact-pack-0.1"},
    "replacement_set_id": {"type": "string", "minLength": 1, "pattern": "\\S"},
    "case_schema_version": {"const": "qualityci-case-0.4"},
    "parser_contract_version": {"const": "qualityci-ingestion-policy-0.2"},
    "mapping_contract_version": {"const": "qualityci-explicit-mapping-0.5"},
    "security_root_policy_version": {"const": "qualityci-artifact-root-policy-0.1"},
    "documents": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source_id", "source_path", "document_id", "document_type", "revision", "status", "owner", "revision_date", "columns", "header_row", "table_selector", "supersedes"],
        "properties": {
          "source_id": {"type": "string", "minLength": 1, "pattern": "\\S"},
          "source_path": {"type": "string", "minLength": 1, "pattern": "^(?![.]{1,2}$)(?![\\s\\S]*[/\\\\])(?![\\s\\S]*[\\u0000-\\u001F])(?=\\S(?:[\\s\\S]*\\S)?$)[\\s\\S]+\\.(?:[cC][sS][vV]|[xX][lL][sS][xX]|[dD][oO][cC][xX])$", "x-qualityci-executable-format": "qualityci-revision-source-path"},
          "document_id": {"type": "string", "minLength": 1, "pattern": "\\S"},
          "document_type": {"enum": ["PROCESS_FLOW", "PFMEA", "CONTROL_PLAN", "SOP", "INSPECTION_RECORD"]},
          "revision": {"type": "string", "minLength": 1, "pattern": "\\S"},
          "status": {"enum": ["DRAFT", "APPROVED", "SUPERSEDED"]},
          "owner": {"type": "string", "minLength": 1, "pattern": "\\S"},
          "revision_date": {"type": "string", "format": "date"},
          "columns": {"type": "object", "minProperties": 1, "propertyNames": {"minLength": 1, "pattern": "\\S"}, "additionalProperties": {"type": "string", "minLength": 1, "pattern": "\\S"}},
          "header_row": {"type": "integer", "minimum": 1},
          "table_selector": {"type": ["object", "null"]},
          "supersedes": {
            "type": "object",
            "additionalProperties": false,
            "required": ["document_id", "revision", "source_hash"],
            "properties": {"document_id": {"type": "string", "minLength": 1, "pattern": "\\S"}, "revision": {"type": "string", "minLength": 1, "pattern": "\\S"}, "source_hash": {"type": "string", "minLength": 1, "pattern": "\\S"}}
          }
        }
      }
    }
  }
}
