{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qualityci.local/schemas/mutation.schema.json",
  "title": "QualityCI Benchmark Mutation",
  "type": "object",
  "required": ["mutation_id", "description", "operations", "expected_rule_statuses"],
  "properties": {
    "mutation_id": {"type": "string", "minLength": 1},
    "description": {"type": "string", "minLength": 1},
    "operations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["op", "path"],
        "properties": {
          "op": {"enum": ["set", "delete"]},
          "target": {"enum": ["document", "event", "case"]},
          "document_id": {"type": "string"},
          "path": {"type": "string", "minLength": 1},
          "value": {}
        },
        "allOf": [
          {
            "if": {"properties": {"op": {"const": "set"}}, "required": ["op"]},
            "then": {"required": ["value"]}
          },
          {
            "if": {
              "anyOf": [
                {"properties": {"target": {"const": "document"}}, "required": ["target"]},
                {"not": {"required": ["target"]}}
              ]
            },
            "then": {"required": ["document_id"]}
          }
        ]
      }
    },
    "expected_rule_statuses": {
      "type": "object",
      "minProperties": 7,
      "maxProperties": 7,
      "propertyNames": {"pattern": "^QCI-R[0-9]{3}$"},
      "additionalProperties": {"enum": ["PASS", "CONTRADICTED", "UNVERIFIABLE"]}
    },
    "expected_positive_rules": {"type": "array", "items": {"type": "string"}},
    "expected_evidence_rules": {"type": "array", "items": {"type": "string"}}
  }
}
