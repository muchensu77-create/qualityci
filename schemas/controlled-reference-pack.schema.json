{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qualityci.local/schemas/controlled-reference-pack.schema.json",
  "title": "QualityCI Controlled Reference Raw Pack",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "documents"],
  "properties": {
    "contract_version": {"const": "qualityci-controlled-reference-pack-0.1"},
    "documents": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {"$ref": "#/$defs/document"}
    }
  },
  "$defs": {
    "document": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_id", "source_path", "document_id", "document_type",
        "revision", "status", "owner", "revision_date", "columns"
      ],
      "properties": {
        "source_id": {"type": "string", "minLength": 1, "pattern": "\\S"},
        "source_path": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?![.]{1,2}$)(?![\\s\\S]*[/\\\\])(?![\\s\\S]*[\\u0000-\\u001F])\\S(?:[\\s\\S]*\\S)?$"
        },
        "document_id": {"type": "string", "minLength": 1, "pattern": "\\S"},
        "document_type": {
          "enum": ["SOP", "CONTROL_PLAN", "INSPECTION_RECORD"]
        },
        "revision": {"type": "string", "minLength": 1, "pattern": "\\S"},
        "status": {"const": "APPROVED"},
        "owner": {"type": "string", "minLength": 1, "pattern": "\\S"},
        "revision_date": {"type": "string", "format": "date"},
        "header_row": {"type": "integer", "minimum": 1},
        "table_selector": {"type": "object"},
        "columns": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": {"minLength": 1, "pattern": "\\S"},
          "additionalProperties": {"type": "string", "minLength": 1, "pattern": "\\S"}
        }
      }
    }
  }
}
